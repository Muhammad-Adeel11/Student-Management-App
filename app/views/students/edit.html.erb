<div class="container">

  <div class="card form-card">

    <h1>Edit Student</h1>

    <p style="color: #cbd5e1;">
      Update the student's information.
    </p>

    <form action="/students/<%= @student.id %>" method="post">

      <input type="hidden" name="_method" value="patch">

      <div class="form-group">
        <label>Name</label>
        <input
          type="text"
          name="student[name]"
          value="<%= @student.name %>"
        >
      </div>

      <div class="form-group">
        <label>Email</label>
        <input
          type="email"
          name="student[email]"
          value="<%= @student.email %>"
        >
      </div>

      <div class="form-group">
        <label>Phone</label>
        <input
          type="text"
          name="student[phone]"
          value="<%= @student.phone %>"
        >
      </div>


      <input
        type="submit"
        value="Update Student"
        class="btn btn-success"
      >

      <a href="/students" class="btn btn-warning">
        Cancel
      </a>

    </form>

  </div>

</div>